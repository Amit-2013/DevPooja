# Copy to backend-python/.env and fill in.
# SQLite is the default (no config needed); Supabase Postgres is one variable away.

# --- database ---------------------------------------------------------------
# Supabase Project Settings -> Database -> Connection string -> URI (pooler, port 6543).
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- auth -------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-any-real-deployment
TOKEN_EXPIRE_HOURS=48

# --- storage ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=40

# --- behaviour --------------------------------------------------------------
DEMO_MODE=true
ENVIRONMENT=development
