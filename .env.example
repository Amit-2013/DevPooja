[TEMPLATE]
# Copy to .env and edit. Never commit .env.
NODE_ENV=development          # set to production when deployed
PORT=3000

# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# Demo mode seeds sample pandits, customers and bookings, and enables demo logins + fixed OTP 123456.
# Defaults to true in development, false in production.
DEMO_MODE=true

# Admin account created at startup (required in production)
ADMIN_EMAIL=admin@deivikpooja.in
ADMIN_PASSWORD=admin123

# Storage (defaults shown)
# DB_PATH=./data/deivikpooja.db
# UPLOAD_DIR=./uploads

# Behind a reverse proxy (nginx, Render, Railway...) set to 1 so rate limits see real client IPs
# TRUST_PROXY=1

# Payments: mock (default, marks payments as paid) or razorpay
PAYMENT_MODE=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx

# SMS and WhatsApp via Twilio (OTP delivery needs at least SMS)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# TWILIO_WA_FROM=whatsapp:+14155238886

# Email via SendGrid
# SENDGRID_KEY=
# MAIL_FROM=no-reply@yourdomain.in
