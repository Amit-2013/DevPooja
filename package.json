{
  "name": "daivikpooja",
  "version": "1.0.0",
  "description": "DaivikPooja – Sanatan Seva Platform: full-stack puja booking platform (Express + SQLite + vanilla JS SPA)",
  "main": "server/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Amit-2013/DevPooja.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --reset",
    "db:migrate": "node server/migrate.js",
    "db:status": "node server/migrate.js --status",
    "db:inspect": "node server/tools/inspect-db.js",
    "db:health": "node server/tools/db-health.js",
    "test": "node --test tests/api.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "build:pages": "node tools/build-pages.js",
    "build:netlify": "node tools/build-netlify.js",
    "preview:pages": "node tools/serve-pages.js",
    "backup": "node tools/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
